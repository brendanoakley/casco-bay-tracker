# Copy this file to .env and paste in your own key from https://aisstream.io
AISSTREAM_API_KEY=your_key_here

# OPTIONAL — Vessel Spotlight works without this, using free Wikidata/Wikipedia
# lookups. Add a Datalastic key (https://datalastic.com) for deeper coverage.
# DATALASTIC_API_KEY=your_key_here
